manifest {
	description = 'NPM1 and FLT3 detection pipeline for MRD samples implemented using Nextflow'
	nextflowVersion = '20.10.0'
}

params {
	input = "${projectDir}/samplesheet.csv"
	sequences = "${projectDir}/samples/"
	bedfile = "${projectDir}/assets/NPM1_FLT3.bed"
	illumina_adapters = "${projectDir}/assets/TruSeq2-PE.fa"
	nextera_adapters = "${projectDir}/assets/NexteraPE-PE.fa"
	genome = "${projectDir}/assets/hg19_all.fasta"
	genome_dir = new File(genome).parent
	ind_files = new File(genome).name	
	filt3r_ref = "${projectDir}/assets/flt3_exon14-15.fa"
	genome_minimap_getitd = "${projectDir}/assets/hg37.fa"
	outdir = "${projectDir}/Final_Output"
	annovar_humandb = "${baseDir}/assets/humandb"
	gen_ref = "${projectDir}/assets/gene_fullxref.txt"
	filt3r = "filt3r"
	varscan = "varscan"
	trace_report_suffix = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')// Config options
}

def humandb_real = new File(params.annovar_humandb).canonicalPath
def reffile_real = new File(params.gen_ref).canonicalPath

process {
	// TODO nf-core: Check the defaults for all processes
	cpus   = { 1      * task.attempt }
	memory = { 6.GB   * task.attempt }
	time   = { 4.h    * task.attempt }

	errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
	maxRetries    = 1
	maxErrors     = '-1'

	withLabel:process_single {
		cpus   = { 1                   }
		memory = { 6.GB * task.attempt }
		time   = { 4.h   * task.attempt }	
	}
	withLabel:process_low {
		cpus   = { 8     * task.attempt }
		memory = { 12.GB * task.attempt }
		time   = { 8.h   * task.attempt }
	}
	withLabel:process_medium {
		cpus   = { 16     * task.attempt }
		memory = { 36.GB * task.attempt }
		time   = { 16.h   * task.attempt }
	}
	withLabel:process_high {
		cpus   = { 32    * task.attempt }
		memory = { 72.GB * task.attempt }
		time   = { 32.h   * task.attempt }
	}
	withLabel:process_long {
		cpus   = { 16    * task.attempt }
	}
	withLabel:process_high_memory {
		memory = { 200.GB * task.attempt }
	}
	withName:TRIM {
		container = 'quay.io/biocontainers/trimmomatic:0.39--hdfd78af_2'
	}
	withName:MAPBAM {
		container = 'docker.io/dukegcb/bwa-samtools:latest'
	}
	withName:/(FILT3R|GETITD)/ {
		container = 'docker.io/gulnazzaidi/getitd_filt3r:v0.90'
	}
	withName:MINIMAP {
		container = 'docker.io/staphb/minimap2:2.30'
	}
	withName:FLT3_ITD_EXT {
		container = 'docker.io/zhkddocker/flt3_itd_ext:v1.1'
	}
	withName:/(COVERAGE|BAM_TO_FASTQ)/ {
		container = 'quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
	}
	withName:/(VARSCAN|MINIMAP_SORT)/ {
		container = 'docker.io/gulnazzaidi/varscan:2.3.9'
	}
	withName:ANNOVAR {
		container = 'docker.io/bioinfochrustrasbourg/annovar:2018Apr16'
		containerOptions = "-v ${humandb_real}:/databases/humandb -v ${reffile_real}:/databases/gene_fullxref.txt"
	}
	withName:/(FORMAT_FLT3|FORMAT_NPM1|COMBINE_FLT3|COMBINE_NPM1)/ {
		container = 'docker.io/jupyter/scipy-notebook:x86_64-ubuntu-22.04'
	}
}

profiles {
	docker {
		docker.enabled          = true 
		docker.runOptions = '-u $(id -u):$(id -g)'
	}
}

timeline {
	enabled = true
	file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
	enabled = true
	file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
	enabled = true
	file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
	enabled = true
	file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
